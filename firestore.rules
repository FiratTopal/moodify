rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /oturumlar/{docId} {
      // Sadece giriş yapmış kullanıcılar kendi verilerini okuyabilir ve yazabilir
      allow read, write: if request.auth != null && request.auth.uid == resource.data.kullaniciId;
      // Yeni veri eklerken de ekleyen kişinin kendi ID'si olması şartı
      allow create: if request.auth != null && request.auth.uid == request.resource.data.kullaniciId;
    }
  }
}
